#!/usr/bin/env bash

set -euo pipefail

conventional_commit_regex='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9._/-]+\))?(!)?: .+'
commit_message="$(head -n 1 "$1")"

if [[ "$commit_message" =~ $conventional_commit_regex ]]; then
  exit 0
fi

echo "Commit subject must follow Conventional Commits." >&2
echo "Example: feat(releases): add a country filter" >&2
exit 1
